#!/usr/bin/env python3
"""FNXVM dynamic guest OS resolver.

Resolves official vendor download URLs, versions, checksum URLs, and signature
URLs dynamically at runtime (and at CI build time for documentation). Never
redistributes OS media.

Maintainer: Daniel G. Cosenza from FNX Labs
License: MIT
"""
from __future__ import annotations

import argparse
import html
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from typing import Any

USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64; rv:152.0) Gecko/20100101 Firefox/152.0"
)
VALID_OS = ("windows", "haiku", "freebsd", "daemonarchy", "debian", "ubuntu", "omarchy")
VALID_DESKTOPS = ("gnome", "kde")
HTTP_TIMEOUT = 30


class ResolveError(RuntimeError):
    """Raised when an OS, architecture, or upstream endpoint cannot be resolved."""


def normalize_arch(raw: str | None) -> str:
    val = (raw or "").strip().lower()
    if not val:
        m = platform.machine().lower()
        if m in ("x86_64", "amd64"):
            return "amd64"
        if m in ("aarch64", "arm64"):
            return "arm64"
        return m
    if val in ("amd64", "x86_64", "x64"):
        return "amd64"
    if val in ("arm64", "aarch64"):
        return "arm64"
    raise ResolveError(
        f"Unsupported architecture '{raw}'. Supported architectures: amd64, arm64."
    )


def http_get_bytes(url: str, headers: dict[str, str] | None = None) -> tuple[bytes, str]:
    req_headers = {"User-Agent": USER_AGENT}
    if headers:
        req_headers.update(headers)
    req = urllib.request.Request(url, headers=req_headers)
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            return resp.read(), resp.geturl()
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError) as exc:
        raise ResolveError(f"Failed to fetch {url}: {exc}") from exc


def http_get_text(url: str, headers: dict[str, str] | None = None) -> tuple[str, str]:
    data, eff = http_get_bytes(url, headers=headers)
    return data.decode("utf-8", errors="replace"), eff


def http_head_final(url: str) -> tuple[int, str]:
    """Follow redirects and return (status_code, final_url), falling back to Range GET."""
    for method, extra_headers in (("HEAD", {}), ("GET", {"Range": "bytes=0-0"})):
        req = urllib.request.Request(
            url,
            method=method,
            headers={"User-Agent": USER_AGENT, **extra_headers},
        )
        try:
            with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
                status = getattr(resp, "status", 200)
                final_url = resp.geturl()
                if method == "GET":
                    resp.read(1)
                return status, final_url
        except urllib.error.HTTPError as exc:
            if method == "HEAD" and exc.code in (403, 405, 501):
                continue
            return exc.code, url
        except (urllib.error.URLError, TimeoutError) as exc:
            if method == "HEAD":
                continue
            raise ResolveError(f"URL check failed for {url}: {exc}") from exc
    return 0, url


def http_first_redirect(url: str) -> str:
    """Return the first redirect Location header without downloading the target."""

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    opener = urllib.request.build_opener(NoRedirect())
    req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": USER_AGENT})
    try:
        with opener.open(req, timeout=HTTP_TIMEOUT) as resp:
            return resp.headers.get("Location", "") or resp.geturl()
    except urllib.error.HTTPError as exc:
        if exc.code in (301, 302, 303, 307, 308):
            return exc.headers.get("Location", "")
        return ""
    except (urllib.error.URLError, TimeoutError):
        return ""


def parse_version_tuple(ver: str) -> tuple[int, ...]:
    return tuple(int(p) for p in re.findall(r"[0-9]+", ver))


DEBIAN_CD_MIRRORS = (
    "https://ftp.fau.de/debian-cd",
    "https://mirrors.ocf.berkeley.edu/debian-cd",
    "https://mirror.csclub.uwaterloo.ca/debian-cd",
    "https://mirror.steadfastnet.com/debian-cd",
    "https://ftp.riken.jp/Linux/debian/debian-cd",
)


def resolve_debian(arch: str, desktop: str) -> dict[str, Any]:
    desk = (desktop or "gnome").strip().lower()
    if desk not in VALID_DESKTOPS:
        raise ResolveError(
            f"Invalid DESKTOP '{desktop}' for OS=debian. Valid values: {', '.join(VALID_DESKTOPS)}."
        )

    if arch == "amd64":
        rel_dir = "current-live/amd64/iso-hybrid"
        base = f"https://cdimage.debian.org/debian-cd/{rel_dir}"
        sums_url = f"{base}/SHA256SUMS"
        sig_url = f"{base}/SHA256SUMS.sign"
        body, _ = http_get_text(sums_url)
        pattern = re.compile(
            rf"^([0-9a-f]{{64}})\s+\*?(debian-live-([0-9]+\.[0-9]+(?:\.[0-9]+)?)-amd64-{re.escape(desk)}\.iso)$",
            re.MULTILINE,
        )
        m = pattern.search(body)
        if not m:
            raise ResolveError(
                f"Could not locate Debian live {desk} amd64 ISO in {sums_url}."
            )
        sha256, filename, version = m.group(1), m.group(2), m.group(3)
        mirrors = [f"{mirror}/{rel_dir}/{filename}" for mirror in DEBIAN_CD_MIRRORS]
        return {
            "os": "debian",
            "guest": f"Debian Desktop ({desk.upper()} live)",
            "arch": arch,
            "desktop": desk,
            "version": version,
            "version_policy": "latest stable live ISO",
            "iso_url": f"{base}/{filename}",
            "iso_filename": filename,
            "mirrors": mirrors,
            "checksum_url": sums_url,
            "checksum_algorithm": "sha256",
            "checksum_value": sha256,
            "signature_url": sig_url,
            "verify_method": "sha256+gpg",
            "gpg_keyring": "/etc/fnxvm/keys/debian-cd.gpg",
            "notes": f"Official Debian {version} live ISO with {desk.upper()} desktop.",
        }

    # arm64: Debian does not publish official current-live/arm64 ISOs; use official DVD-1 installer
    rel_dir = "current/arm64/iso-dvd"
    base = f"https://cdimage.debian.org/debian-cd/{rel_dir}"
    sums_url = f"{base}/SHA256SUMS"
    sig_url = f"{base}/SHA256SUMS.sign"
    body, _ = http_get_text(sums_url)
    pattern = re.compile(
        r"^([0-9a-f]{64})\s+\*?(debian-([0-9]+\.[0-9]+(?:\.[0-9]+)?)-arm64-DVD-1\.iso)$",
        re.MULTILINE,
    )
    m = pattern.search(body)
    if not m:
        raise ResolveError(f"Could not locate Debian arm64 DVD-1 ISO in {sums_url}.")
    sha256, filename, version = m.group(1), m.group(2), m.group(3)
    mirrors = [f"{mirror}/{rel_dir}/{filename}" for mirror in DEBIAN_CD_MIRRORS]
    return {
        "os": "debian",
        "guest": f"Debian ({desk.upper()} via arm64 DVD-1 installer)",
        "arch": arch,
        "desktop": desk,
        "version": version,
        "version_policy": "latest stable installer ISO (Debian publishes no official arm64 live ISO)",
        "iso_url": f"{base}/{filename}",
        "iso_filename": filename,
        "mirrors": mirrors,
        "checksum_url": sums_url,
        "checksum_algorithm": "sha256",
        "checksum_value": sha256,
        "signature_url": sig_url,
        "verify_method": "sha256+gpg",
        "gpg_keyring": "/etc/fnxvm/keys/debian-cd.gpg",
        "notes": (
            f"Debian does not publish official arm64 live ISOs; using official Debian {version} "
            f"arm64 DVD-1 installer (select {desk.upper()} during installation)."
        ),
    }


def resolve_ubuntu(arch: str) -> dict[str, Any]:
    index_html, _ = http_get_text("https://releases.ubuntu.com/")
    # LTS series are even-year April releases: YY.04 where YY % 2 == 0
    series = sorted(
        {
            m.group(1)
            for m in re.finditer(r'href="([0-9]{2})\.04/"', index_html)
            if int(m.group(1)) % 2 == 0
        },
        key=int,
        reverse=True,
    )
    if not series:
        raise ResolveError("Could not find any Ubuntu LTS series on releases.ubuntu.com.")

    for yy in series:
        lts = f"{yy}.04"
        if arch == "amd64":
            base = f"https://releases.ubuntu.com/{lts}"
        else:
            base = f"https://cdimage.ubuntu.com/ubuntu/releases/{lts}/release"
        sums_url = f"{base}/SHA256SUMS"
        sig_url = f"{base}/SHA256SUMS.gpg"
        try:
            body, _ = http_get_text(sums_url)
        except ResolveError:
            continue

        matches = re.findall(
            rf"^([0-9a-f]{{64}})\s+\*?(ubuntu-({re.escape(lts)}(?:\.[0-9]+)?)-desktop-{re.escape(arch)}\.iso)$",
            body,
            re.MULTILINE,
        )
        if not matches:
            continue
        # Pick highest point release (e.g. 26.04.1 over 26.04)
        matches.sort(key=lambda item: parse_version_tuple(item[2]), reverse=True)
        sha256, filename, version = matches[0]
        return {
            "os": "ubuntu",
            "guest": "Ubuntu Desktop LTS",
            "arch": arch,
            "version": f"{version} LTS",
            "version_policy": "latest LTS point release",
            "iso_url": f"{base}/{filename}",
            "iso_filename": filename,
            "checksum_url": sums_url,
            "checksum_algorithm": "sha256",
            "checksum_value": sha256,
            "signature_url": sig_url,
            "verify_method": "sha256+gpg",
            "gpg_keyring": "/etc/fnxvm/keys/ubuntu-cd.gpg",
            "notes": f"Official Ubuntu {version} LTS Desktop ISO ({arch}).",
        }

    raise ResolveError(
        f"Could not find a published Ubuntu Desktop LTS ISO for architecture '{arch}'."
    )


def resolve_freebsd(arch: str) -> dict[str, Any]:
    if arch == "amd64":
        arch_path, arch_tag = "amd64/amd64", "amd64"
    else:
        arch_path, arch_tag = "arm64/aarch64", "arm64-aarch64"

    root_url = f"https://download.freebsd.org/releases/{arch_path}/ISO-IMAGES"
    root_html, _ = http_get_text(f"{root_url}/")
    versions = sorted(
        {m.group(1) for m in re.finditer(r'href="([0-9]+\.[0-9]+)/"', root_html)},
        key=parse_version_tuple,
        reverse=True,
    )
    if not versions:
        raise ResolveError(f"Could not list FreeBSD versions at {root_url}/.")

    for ver in versions:
        dir_url = f"{root_url}/{ver}"
        try:
            dir_html, _ = http_get_text(f"{dir_url}/")
        except ResolveError:
            continue
        checksum_name = f"CHECKSUM.SHA256-FreeBSD-{ver}-RELEASE-{arch_tag}"
        iso_name = f"FreeBSD-{ver}-RELEASE-{arch_tag}-disc1.iso"
        # Require production -RELEASE (skip -BETA, -RC, -ALPHA directories)
        if f'href="{checksum_name}"' not in dir_html or f'href="{iso_name}"' not in dir_html:
            continue
        checksum_url = f"{dir_url}/{checksum_name}"
        sums_text, _ = http_get_text(checksum_url)
        m = re.search(
            rf"^SHA256\s+\({re.escape(iso_name)}\)\s+=\s+([0-9a-f]{{64}})$",
            sums_text,
            re.MULTILINE,
        )
        if not m:
            continue
        return {
            "os": "freebsd",
            "guest": "FreeBSD",
            "arch": arch,
            "version": f"{ver}-RELEASE",
            "version_policy": "latest production -RELEASE",
            "iso_url": f"{dir_url}/{iso_name}",
            "iso_filename": iso_name,
            "checksum_url": checksum_url,
            "checksum_algorithm": "sha256",
            "checksum_value": m.group(1),
            "signature_url": "",
            "verify_method": "sha256",
            "gpg_keyring": "",
            "notes": f"Official FreeBSD {ver}-RELEASE production disc1 ISO ({arch}).",
        }

    raise ResolveError(f"Could not find any production FreeBSD -RELEASE for '{arch}'.")


def resolve_haiku(arch: str) -> dict[str, Any]:
    if arch != "amd64":
        raise ResolveError(
            "Haiku does not publish official arm64 release ISOs (only x86_64/amd64 and x86). "
            "Supported arm64 OS values: windows, freebsd, daemonarchy, debian, ubuntu, omarchy."
        )

    page_html, eff_url = http_get_text("https://www.haiku-os.org/get-haiku/")
    slug = ""
    m_url = re.search(r"/get-haiku/(r[0-9]+(?:beta[0-9]+|\.[0-9]+)*)/?", eff_url)
    if m_url:
        slug = m_url.group(1)
    else:
        m_link = re.search(
            r"/get-haiku/(r[0-9]+(?:beta[0-9]+|\.[0-9]+)*)/", page_html
        )
        if m_link:
            slug = m_link.group(1)
            page_html, _ = http_get_text(f"https://www.haiku-os.org/get-haiku/{slug}/")

    if not slug:
        raise ResolveError("Could not determine latest Haiku release from haiku-os.org.")

    ver_match = re.search(r"Version:</strong>\s*([^<\r\n]+)", page_html)
    version = ver_match.group(1).strip() if ver_match else slug

    iso_name = f"haiku-{slug}-x86_64-anyboot.iso"
    cdn_base = f"https://haiku-release.cdn.haiku-os.org/{slug}"
    iso_url = f"{cdn_base}/{iso_name}"
    checksum_url = f"{cdn_base}/{iso_name}.sha256"
    sig_url = f"{cdn_base}/{iso_name}.minisig"

    # Parse sha256 from official CDN .sha256 file (fallback to page embedded SHA256)
    sha256 = ""
    try:
        sums_text, _ = http_get_text(checksum_url)
        m_sum = re.search(r"([0-9a-f]{64})", sums_text)
        if m_sum:
            sha256 = m_sum.group(1)
    except ResolveError:
        m_page_sum = re.search(
            rf"([0-9a-f]{{64}})\s+{re.escape(iso_name)}", page_html
        )
        if m_page_sum:
            sha256 = m_page_sum.group(1)
            checksum_url = f"https://www.haiku-os.org/get-haiku/{slug}/"

    if not sha256:
        raise ResolveError(f"Could not resolve SHA-256 checksum for Haiku {slug}.")

    # Collect official mirrors from page as fallback metadata
    mirrors = sorted(
        set(
            re.findall(
                rf"https://[^\s\"'<>]+/{re.escape(iso_name)}",
                page_html,
            )
        )
    )

    return {
        "os": "haiku",
        "guest": "Haiku",
        "arch": arch,
        "version": version,
        "version_policy": "latest release (R1/betaN)",
        "iso_url": iso_url,
        "iso_filename": iso_name,
        "mirrors": mirrors,
        "checksum_url": checksum_url,
        "checksum_algorithm": "sha256",
        "checksum_value": sha256,
        "signature_url": sig_url,
        "verify_method": "sha256",
        "gpg_keyring": "",
        "notes": f"Official Haiku {version} x86_64 anyboot ISO (amd64 only; minisig also published).",
    }


def resolve_daemonarchy(arch: str) -> dict[str, Any]:
    arch_tag = "amd64" if arch == "amd64" else "aarch64"
    tag_re = re.compile(r"^daemonarchy-([0-9]+\.[0-9]+\.[0-9]+)$")

    headers = {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    token = (os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN") or "").strip()
    if token:
        headers["Authorization"] = f"Bearer {token}"

    candidates: list[tuple[tuple[int, ...], str, str, str, str]] = []
    api_error: ResolveError | None = None

    # Primary: GitHub Releases API (paginated; skips packages-16-*, checkouts-16-*,
    # extensions-16-*, drafts, and prereleases).
    for page in range(1, 6):
        url = (
            "https://api.github.com/repos/jordanhubbard/daemonarchy/releases"
            f"?per_page=100&page={page}"
        )
        try:
            raw, _ = http_get_text(url, headers=headers)
            releases = json.loads(raw)
        except (ResolveError, json.JSONDecodeError) as exc:
            api_error = ResolveError(str(exc))
            break
        if not isinstance(releases, list) or not releases:
            break

        for rel in releases:
            if not isinstance(rel, dict):
                continue
            if rel.get("draft") or rel.get("prerelease"):
                continue
            tag = (rel.get("tag_name") or "").strip()
            m = tag_re.fullmatch(tag)
            if not m:
                continue
            ver = m.group(1)
            iso_name = f"daemonarchy-{ver}-{arch_tag}.iso.xz"
            sha_name = f"{iso_name}.sha256"
            assets = {
                (a.get("name") or ""): (a.get("browser_download_url") or "")
                for a in (rel.get("assets") or [])
                if isinstance(a, dict)
            }
            iso_url = assets.get(iso_name, "")
            sha_url = assets.get(sha_name, "")
            if iso_url and sha_url:
                candidates.append((parse_version_tuple(ver), ver, iso_name, iso_url, sha_url))

        if len(releases) < 100 or candidates:
            break

    # Graceful unauthenticated fallback when GitHub API is rate-limited at runtime:
    # parse the public releases/tags HTML pages for matching installer tags.
    if not candidates:
        found_vers: set[str] = set()
        for html_url in (
            "https://github.com/jordanhubbard/daemonarchy/releases",
            "https://github.com/jordanhubbard/daemonarchy/tags",
        ):
            try:
                page_html, _ = http_get_text(html_url)
            except ResolveError:
                continue
            for m in re.finditer(
                r"/jordanhubbard/daemonarchy/releases/tag/daemonarchy-([0-9]+\.[0-9]+\.[0-9]+)(?![0-9A-Za-z.-])",
                page_html,
            ):
                found_vers.add(m.group(1))
        for ver in sorted(found_vers, key=parse_version_tuple, reverse=True):
            iso_name = f"daemonarchy-{ver}-{arch_tag}.iso.xz"
            base = f"https://github.com/jordanhubbard/daemonarchy/releases/download/daemonarchy-{ver}"
            iso_url = f"{base}/{iso_name}"
            sha_url = f"{iso_url}.sha256"
            try:
                code, _ = http_head_final(sha_url)
            except ResolveError:
                continue
            if code in (200, 206):
                candidates.append((parse_version_tuple(ver), ver, iso_name, iso_url, sha_url))
                break

    if not candidates:
        detail = f" ({api_error})" if api_error else ""
        raise ResolveError(
            f"Could not find a stable Daemonarchy release with {arch_tag} installer assets{detail}."
        )

    candidates.sort(key=lambda item: item[0], reverse=True)
    _ver_tuple, version, iso_name, iso_url, checksum_url = candidates[0]

    sums_text, _ = http_get_text(checksum_url)
    m_sum = re.search(
        rf"^([0-9a-fA-F]{{64}})\s+\*?{re.escape(iso_name)}$",
        sums_text,
        re.MULTILINE,
    )
    if not m_sum:
        m_sum = re.search(
            rf"^SHA256\s+\({re.escape(iso_name)}\)\s+=\s+([0-9a-fA-F]{{64}})$",
            sums_text,
            re.MULTILINE,
        )
    if not m_sum:
        raise ResolveError(
            f"Could not parse SHA-256 checksum for {iso_name} from {checksum_url}."
        )
    sha256 = m_sum.group(1).lower()

    if arch == "amd64":
        arch_note = "BIOS or UEFI (boot with Secure Boot disabled)."
    else:
        arch_note = (
            "UEFI only; community-validation arm64 image (verified in QEMU, "
            "not broadly validated on physical arm64 hardware)."
        )

    return {
        "os": "daemonarchy",
        "guest": "Daemonarchy (Omarchy desktop on FreeBSD 16.0-CURRENT)",
        "arch": arch,
        "version": version,
        "version_policy": "latest stable release; tracks FreeBSD 16.0-CURRENT, no LTS",
        "iso_url": iso_url,
        "iso_filename": iso_name,
        "checksum_url": checksum_url,
        "checksum_algorithm": "sha256",
        "checksum_value": sha256,
        "signature_url": "",
        "verify_method": "sha256",
        "gpg_keyring": "",
        "notes": (
            f"Official Daemonarchy {version} compressed installer ({iso_name}). "
            f"{arch_note} SHA-256 covers the compressed .iso.xz and is verified before "
            "xz decompression. Not affiliated with Omarchy; recommend >= 40G DISK_SIZE "
            "and active internet connectivity during installation (~1,200 packages)."
        ),
    }


def resolve_omarchy(arch: str) -> dict[str, Any]:
    arch_suffix = "x86" if arch == "amd64" else "aarch64"
    version = ""

    # Primary: parse official omarchy.org download links (avoids GitHub API rate limits)
    try:
        page_html, _ = http_get_text("https://omarchy.org/")
        m = re.search(
            rf"https://iso\.omarchy\.org/omarchy-([0-9]+\.[0-9]+(?:\.[0-9]+)?)-{re.escape(arch_suffix)}\.iso",
            page_html,
        )
        if m:
            version = m.group(1)
    except ResolveError:
        pass

    # Fallback: GitHub Releases API (authenticated when GH_TOKEN is set)
    if not version:
        headers = {"Accept": "application/vnd.github+json"}
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        if token:
            headers["Authorization"] = f"Bearer {token}"
        raw, _ = http_get_text(
            "https://api.github.com/repos/omacom/omarchy/releases/latest",
            headers=headers,
        )
        tag = (json.loads(raw).get("tag_name") or "").strip()
        version = tag.lstrip("v")

    if not version:
        raise ResolveError("Could not determine latest Omarchy ISO version.")

    iso_name = f"omarchy-{version}-{arch_suffix}.iso"
    iso_url = f"https://iso.omarchy.org/{iso_name}"
    checksum_url = f"{iso_url}.sha256"
    sig_url = f"{iso_url}.sig"

    sums_text, _ = http_get_text(checksum_url)
    m_sum = re.search(r"([0-9a-f]{64})", sums_text)
    if not m_sum:
        raise ResolveError(f"Could not parse SHA-256 checksum from {checksum_url}.")

    return {
        "os": "omarchy",
        "guest": "Omarchy (Arch-based, rolling)",
        "arch": arch,
        "version": version,
        "version_policy": "latest rolling ISO (Arch-based; no LTS exists)",
        "iso_url": iso_url,
        "iso_filename": iso_name,
        "checksum_url": checksum_url,
        "checksum_algorithm": "sha256",
        "checksum_value": m_sum.group(1),
        "signature_url": sig_url,
        "verify_method": "sha256+gpg",
        "gpg_keyring": "/etc/fnxvm/keys/omarchy.gpg",
        "notes": (
            f"Official Omarchy {version} ISO ({arch_suffix}). Omarchy is a rolling "
            "Arch-based distribution; no LTS track exists."
        ),
    }


def normalize_windows_version(raw: str | None, arch: str) -> tuple[str, str]:
    """Normalize dockur/windows VERSION value to (canonical_id, display_name)."""
    v = (raw or "11").strip().lower()
    if not v:
        v = "11"
    plat = "x64" if arch == "amd64" else "arm64"

    # Convenience aliases plus every upstream dockur/windows VERSION token
    if v in ("11", "11p", "win11", "pro11", "win11p", "windows11", "windows 11"):
        return f"win11{plat}", "Windows 11 Pro"
    if v in ("11e", "win11e", "windows11e", "windows 11e"):
        return f"win11{plat}-enterprise-eval", "Windows 11 Enterprise (Evaluation)"
    if v in (
        "11l",
        "11ltsc",
        "ltsc",
        "ltsc11",
        "win11l",
        "win11-ltsc",
        "win11x64-ltsc",
        "win11arm64-ltsc",
    ):
        return f"win11{plat}-enterprise-ltsc-eval", "Windows 11 Enterprise LTSC (Evaluation)"
    if v in (
        "11i",
        "11iot",
        "iot-ltsc",
        "iot11",
        "win11i",
        "win11-iot",
        "win11x64-iot",
        "win11arm64-iot",
    ):
        return (
            f"win11{plat}-enterprise-iot-eval",
            "Windows 11 IoT Enterprise LTSC (Evaluation)",
        )
    if v in ("10", "10p", "win10", "pro10", "win10p", "windows10", "windows 10"):
        return f"win10{plat}", "Windows 10 Pro"
    if v in ("10e", "win10e", "windows10e", "windows 10e"):
        return f"win10{plat}-enterprise-eval", "Windows 10 Enterprise (Evaluation)"
    if v in ("10l", "10ltsc", "ltsc10", "win10l", "win10-ltsc", "win10x64-ltsc", "win10arm64-ltsc"):
        return f"win10{plat}-enterprise-ltsc-eval", "Windows 10 Enterprise LTSC (Evaluation)"
    if v in ("10i", "10iot", "iot10", "win10i", "win10-iot", "win10x64-iot", "win10arm64-iot"):
        return f"win10{plat}-enterprise-iot-eval", "Windows 10 IoT Enterprise LTSC (Evaluation)"

    server_map = {
        ("25", "2025", "win25", "win2025", "windows2025", "windows 2025"): (
            "win2025-eval",
            "Windows Server 2025 (Evaluation)",
        ),
        ("22", "2022", "win22", "win2022", "windows2022", "windows 2022"): (
            "win2022-eval",
            "Windows Server 2022 (Evaluation)",
        ),
        ("19", "2019", "win19", "win2019", "windows2019", "windows 2019"): (
            "win2019-eval",
            "Windows Server 2019 (Evaluation)",
        ),
        ("16", "2016", "win16", "win2016", "windows2016", "windows 2016"): (
            "win2016-eval",
            "Windows Server 2016 (Evaluation)",
        ),
        ("hv", "hyperv", "hyper v", "hyper-v", "19hv", "2019hv", "win2019hv"): (
            "win2019-hv",
            "Hyper-V Server 2019",
        ),
        ("2012", "2012r2", "win2012", "win2012r2", "windows2012", "windows 2012"): (
            "win2012r2-eval",
            "Windows Server 2012 R2 (Evaluation)",
        ),
    }
    for keys, val in server_map.items():
        if v in keys:
            if arch != "amd64":
                raise ResolveError(f"{val[1]} is not available for arm64.")
            return val

    if v.startswith(("http://", "https://")):
        return v, "Windows (custom URL)"

    raise ResolveError(
        f"Unsupported or legacy Windows VERSION '{raw}' for resolver dry-run on {arch}. "
        "Supported official Microsoft resolver values: 11, 11e, 11l/ltsc, 11i/iot-ltsc, 10, 2025, 2022, 2019, 2016, 2012r2."
    )


def resolve_windows_eval(canonical: str, desc: str, arch: str) -> dict[str, Any]:
    eval_pages = {
        "win11x64-enterprise-eval": ("windows-11-enterprise", "enterprise", 0),
        "win11arm64-enterprise-eval": ("windows-11-enterprise", "enterprise", 1),
        "win11x64-enterprise-ltsc-eval": ("windows-11-enterprise", "ltsc", 1),
        "win11arm64-enterprise-ltsc-eval": ("windows-11-iot-enterprise-ltsc-eval", "iot", 1),
        "win11x64-enterprise-iot-eval": ("windows-11-iot-enterprise-ltsc-eval", "iot", 0),
        "win11arm64-enterprise-iot-eval": ("windows-11-iot-enterprise-ltsc-eval", "iot", 1),
        "win2025-eval": ("windows-server-2025", "server", 0),
        "win2022-eval": ("windows-server-2022", "server", 0),
        "win2019-eval": ("windows-server-2019", "server", 0),
        "win2019-hv": ("hyper-v-server-2019", "server", 0),
        "win2016-eval": ("windows-server-2016", "server", 0),
        "win2012r2-eval": ("windows-server-2012-r2", "server", 0),
    }
    if canonical not in eval_pages:
        raise ResolveError(f"No Microsoft Evaluation Center page mapped for {canonical}.")

    slug, _kind, idx = eval_pages[canonical]
    page_url = f"https://www.microsoft.com/en-us/evalcenter/download-{slug}"
    page_html, _ = http_get_text(page_url)
    page_html = html.unescape(page_html)

    fwlinks: list[str] = []
    seen: set[str] = set()
    for m in re.finditer(
        r"https://go\.microsoft\.com/fwlink(?:/p)?/\?[^\"'<>\s]+",
        page_html,
        re.IGNORECASE,
    ):
        u = m.group(0)
        if u not in seen:
            seen.add(u)
            fwlinks.append(u)

    en_links = [
        u
        for u in fwlinks
        if re.search(r"(^|[?&])culture=en-us(&|$)", u, re.IGNORECASE)
        and re.search(r"(^|[?&])country=us(&|$)", u, re.IGNORECASE)
    ]
    if not en_links:
        for cand in fwlinks:
            redir = http_first_redirect(cand).lower()
            if "enus" in re.sub(r"[^a-z0-9]", "", redir.split("?", 1)[0]):
                en_links.append(cand)

    if idx >= len(en_links):
        raise ResolveError(
            f"Could not find expected Evaluation Center download link for {desc} on {page_url}."
        )

    status, eff_url = http_head_final(en_links[idx])
    if status != 200:
        raise ResolveError(
            f"Microsoft Evaluation Center link returned HTTP {status} for {desc}."
        )

    fname = eff_url.split("?", 1)[0].rsplit("/", 1)[-1]
    build_m = re.search(r"([0-9]{5}\.[0-9]+)", fname)
    ver_str = f"{canonical} (build {build_m.group(1)})" if build_m else canonical
    return {
        "os": "windows",
        "guest": desc,
        "arch": arch,
        "windows_id": canonical,
        "version": ver_str,
        "version_policy": "official Microsoft Evaluation Center endpoint (same as dockur/windows)",
        "iso_url": eff_url,
        "iso_filename": fname,
        "checksum_url": page_url,
        "checksum_algorithm": "microsoft-https",
        "checksum_value": "",
        "signature_url": "",
        "verify_method": "microsoft-eval-https",
        "gpg_keyring": "",
        "notes": (
            f"Resolved dynamically from Microsoft Evaluation Center ({page_url}). "
            "Microsoft does not publish standalone SHA-256 files for Evaluation Center ISOs."
        ),
    }


def resolve_windows_esd(canonical: str, desc: str, arch: str, language: str) -> dict[str, Any]:
    if canonical.startswith("win11"):
        catalog_fwlink = "https://go.microsoft.com/fwlink?linkid=2156292"
        win_label = "Windows 11"
    else:
        catalog_fwlink = "https://go.microsoft.com/fwlink/?LinkId=841361"
        win_label = "Windows 10"

    target_arch = "x64" if arch == "amd64" else "arm64"
    target_edition = "enterprise" if "enterprise" in canonical else "professional"
    target_lang = "en-us" if language.lower() in ("", "en", "en-us", "english") else language.lower()

    cab_bytes, catalog_url = http_get_bytes(catalog_fwlink)
    with tempfile.TemporaryDirectory(prefix="fnxvm-esd-") as tmpdir:
        cab_path = os.path.join(tmpdir, "catalog.cab")
        with open(cab_path, "wb") as fh:
            fh.write(cab_bytes)
        if shutil.which("cabextract"):
            subprocess.run(
                ["cabextract", "-q", "-d", tmpdir, cab_path],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        elif shutil.which("7z"):
            subprocess.run(
                ["7z", "x", "-y", f"-o{tmpdir}", cab_path],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        else:
            raise ResolveError("Neither cabextract nor 7z is installed to parse Microsoft ESD catalog.")

        xml_path = os.path.join(tmpdir, "products.xml")
        if not os.path.isfile(xml_path):
            raise ResolveError(f"products.xml not found inside Microsoft catalog {catalog_url}.")

        tree = ET.parse(xml_path)
        chosen: dict[str, str] | None = None
        for elem in tree.iter():
            if elem.tag.rsplit("}", 1)[-1].lower() != "file":
                continue
            fields: dict[str, str] = {}
            for child in elem:
                k = child.tag.rsplit("}", 1)[-1].lower()
                fields[k] = (child.text or "").strip()
            if fields.get("architecture", "").lower() != target_arch:
                continue
            if fields.get("edition", "").lower() != target_edition:
                continue
            if fields.get("languagecode", "").lower() != target_lang:
                continue
            chosen = fields
            break

    if not chosen or not chosen.get("filepath"):
        raise ResolveError(
            f"No official Microsoft ESD entry found for {desc} ({target_arch}, {target_lang}) in {catalog_url}."
        )

    esd_url = chosen["filepath"]
    sha256 = chosen.get("sha256", "")
    sha1 = chosen.get("sha1", "")
    algo = "sha256" if sha256 else "sha1"
    digest = sha256 or sha1
    fname = esd_url.split("?", 1)[0].rsplit("/", 1)[-1]
    build_m = re.search(r"([0-9]{5}\.[0-9]+)", fname)
    ver_str = f"{win_label} ({canonical}, build {build_m.group(1)})" if build_m else f"{win_label} ({canonical})"

    return {
        "os": "windows",
        "guest": desc,
        "arch": arch,
        "windows_id": canonical,
        "version": ver_str,
        "version_policy": "official Microsoft Media Creation Tool ESD catalog (and live consumer API at runtime)",
        "iso_url": esd_url,
        "iso_filename": fname,
        "checksum_url": catalog_url,
        "checksum_algorithm": algo,
        "checksum_value": digest,
        "signature_url": "",
        "verify_method": f"microsoft-esd-{algo}",
        "gpg_keyring": "",
        "notes": (
            f"Resolved dynamically from Microsoft official ESD catalog ({catalog_url}) "
            f"with embedded {algo.upper()} verification. At runtime dockur/windows also tries "
            "Microsoft's live consumer ISO endpoint first and falls back to this verified ESD catalog."
        ),
    }


def resolve_windows(arch: str, version: str | None, language: str) -> dict[str, Any]:
    canonical, desc = normalize_windows_version(version, arch)
    if canonical.startswith(("http://", "https://")):
        return {
            "os": "windows",
            "guest": desc,
            "arch": arch,
            "windows_id": "custom",
            "version": "custom",
            "version_policy": "user-supplied URL",
            "iso_url": canonical,
            "iso_filename": canonical.split("?", 1)[0].rsplit("/", 1)[-1] or "custom.iso",
            "checksum_url": "",
            "checksum_algorithm": "none",
            "checksum_value": "",
            "signature_url": "",
            "verify_method": "none (custom URL)",
            "gpg_keyring": "",
            "notes": "Custom user-supplied Windows media URL.",
        }
    if canonical.endswith("-eval") or canonical == "win2019-hv":
        return resolve_windows_eval(canonical, desc, arch)
    return resolve_windows_esd(canonical, desc, arch, language)


def resolve_os(
    os_name: str | None,
    arch: str,
    desktop: str,
    version: str | None,
    language: str,
    boot_url: str | None,
) -> dict[str, Any]:
    raw_os = (os_name or "").strip().lower()
    raw_boot = (boot_url or "").strip()
    raw_ver = (version or "").strip()

    if not raw_os:
        if raw_boot.lower().startswith(("http://", "https://")):
            return {
                "os": "custom",
                "guest": "Custom boot image",
                "arch": arch,
                "version": "custom",
                "version_policy": "user-supplied BOOT URL",
                "iso_url": raw_boot,
                "iso_filename": raw_boot.split("?", 1)[0].rsplit("/", 1)[-1] or "boot.iso",
                "checksum_url": "",
                "checksum_algorithm": "none",
                "checksum_value": "",
                "signature_url": "",
                "verify_method": "none (custom URL)",
                "gpg_keyring": "",
                "notes": "Custom media URL passed via BOOT.",
            }
        if raw_ver:
            raw_os = "windows"
        else:
            raw_os = "debian"

    if raw_os not in VALID_OS:
        raise ResolveError(
            f"Unknown OS '{os_name}'. Valid OS values: {', '.join(VALID_OS)}. "
            "For a custom ISO or disk image URL, leave OS unset and set BOOT=https://..."
        )

    if raw_os == "debian":
        return resolve_debian(arch, desktop)
    if raw_os == "ubuntu":
        return resolve_ubuntu(arch)
    if raw_os == "freebsd":
        return resolve_freebsd(arch)
    if raw_os == "daemonarchy":
        return resolve_daemonarchy(arch)
    if raw_os == "haiku":
        return resolve_haiku(arch)
    if raw_os == "omarchy":
        return resolve_omarchy(arch)
    return resolve_windows(arch, version, language)


def verify_urls(result: dict[str, Any]) -> None:
    checks = [("iso_url", result.get("iso_url", ""))]
    if result.get("checksum_url"):
        checks.append(("checksum_url", result["checksum_url"]))
    if result.get("signature_url"):
        checks.append(("signature_url", result["signature_url"]))

    statuses: dict[str, int] = {}
    for field, url in checks:
        code, _ = http_head_final(url)
        statuses[field] = code
        if code not in (200, 206):
            raise ResolveError(
                f"HTTP check failed for {field} ({url}): got HTTP {code}, expected 200."
            )
    result["http_status"] = statuses


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="fnxvm-resolve",
        description="Dynamically resolve official guest OS ISO and checksum URLs for FNXVM.",
    )
    parser.add_argument(
        "os_arg",
        nargs="?",
        default="",
        help=f"Guest OS ({', '.join(VALID_OS)}). Defaults to $OS env var.",
    )
    parser.add_argument("--arch", default=os.environ.get("FNXVM_ARCH") or os.environ.get("PLATFORM") or "")
    parser.add_argument("--desktop", default=os.environ.get("DESKTOP") or "gnome")
    parser.add_argument("--version", default=os.environ.get("VERSION") or "")
    parser.add_argument("--language", default=os.environ.get("LANGUAGE") or "en")
    parser.add_argument("--boot", default=os.environ.get("BOOT") or "")
    parser.add_argument("--json", action="store_true", help="Emit JSON output.")
    parser.add_argument(
        "--verify-urls",
        action="store_true",
        help="Verify that resolved ISO, checksum, and signature URLs return HTTP 200.",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List supported OS values and exit.",
    )
    args = parser.parse_args(argv)

    if args.list:
        if args.json:
            print(json.dumps({"supported_os": list(VALID_OS), "debian_desktops": list(VALID_DESKTOPS)}))
        else:
            print("Supported OS values: " + ", ".join(VALID_OS))
            print("Debian DESKTOP values: " + ", ".join(VALID_DESKTOPS))
            print("Custom media: leave OS unset and set BOOT=https://...")
        return 0

    try:
        arch = normalize_arch(args.arch)
        os_sel = args.os_arg or os.environ.get("OS") or ""
        result = resolve_os(
            os_name=os_sel,
            arch=arch,
            desktop=args.desktop,
            version=args.version,
            language=args.language,
            boot_url=args.boot,
        )
        if args.verify_urls:
            verify_urls(result)
    except ResolveError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"OS:           {result['os']}")
        print(f"Guest:        {result['guest']}")
        print(f"Architecture: {result['arch']}")
        print(f"Version:      {result['version']}")
        print(f"Policy:       {result['version_policy']}")
        print(f"ISO URL:      {result['iso_url']}")
        if result.get("checksum_url"):
            print(f"Checksum URL: {result['checksum_url']}")
        if result.get("checksum_value"):
            print(
                f"Checksum:     {result['checksum_algorithm']}:{result['checksum_value']}"
            )
        if result.get("signature_url"):
            print(f"Signature:    {result['signature_url']}")
        print(f"Verification: {result['verify_method']}")
        if result.get("http_status"):
            status_str = ", ".join(
                f"{k}={v}" for k, v in result["http_status"].items()
            )
            print(f"HTTP Status:  {status_str}")
        if result.get("notes"):
            print(f"Notes:        {result['notes']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

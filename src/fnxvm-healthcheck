#!/usr/bin/env bash
# FNXVM container healthcheck.
# Verifies that the web viewer (nginx internal loopback health endpoint,
# configured WEB_PORT, and websocketd status socket) or VNC server (when WEB=N)
# is actively serving, and that QEMU stays alive once booted.
# Maintainer: Daniel G. Cosenza from FNX Labs
set -euo pipefail

WEB_PORT="${WEB_PORT:-8006}"
VNC_PORT="${VNC_PORT:-5900}"
WEB="${WEB:-Y}"
WEB_AUTH="${WEB_AUTH:-Y}"
QEMU_DIR="/run/shm"
HEALTH_SOCK="${QEMU_DIR}/nginx-health.sock"

# Fail immediately when the container is shutting down.
if [ -f "${QEMU_DIR}/qemu.end" ]; then
  echo "FNXVM is shutting down" >&2
  exit 1
fi

is_disabled() {
  case "${1,,}" in
    n|no|none|false|0|off|disable|disabled) return 0 ;;
    *) return 1 ;;
  esac
}

if is_disabled "$WEB"; then
  # Headless VNC-only mode: verify VNC TCP port is accepting connections.
  if ! nc -z -w 3 127.0.0.1 "${VNC_PORT}" >/dev/null 2>&1; then
    echo "VNC port ${VNC_PORT} is not listening" >&2
    exit 1
  fi
else
  # Default web-viewer mode:
  # 1. Probe nginx internal Unix-socket health endpoint (not exposed on TCP).
  if [ ! -S "$HEALTH_SOCK" ]; then
    echo "Nginx health socket ${HEALTH_SOCK} is missing" >&2
    exit 1
  fi
  health_body="$(curl -fsS --max-time 4 --unix-socket "$HEALTH_SOCK" http://localhost/healthz 2>/dev/null || true)"
  if [ "$health_body" != "ok" ]; then
    echo "Nginx internal health endpoint failed" >&2
    exit 1
  fi

  # 2. Probe configured WEB_PORT and verify expected status (401 when auth is on, 200 when disabled).
  code="$(curl -sS --max-time 4 -o /dev/null -w '%{http_code}' "http://127.0.0.1:${WEB_PORT}/" || echo "000")"
  if is_disabled "$WEB_AUTH"; then
    if [ "$code" != "200" ]; then
      echo "Web viewer on port ${WEB_PORT} returned HTTP ${code} (expected 200)" >&2
      exit 1
    fi
  else
    if [ "$code" != "401" ]; then
      echo "Web viewer on port ${WEB_PORT} returned HTTP ${code} (expected 401 with WEB_AUTH enabled)" >&2
      exit 1
    fi
  fi

  # 3. Verify websocketd status socket is active.
  if [ ! -S "${QEMU_DIR}/status-ws.sock" ]; then
    echo "Status websocket socket is missing" >&2
    exit 1
  fi
fi

# If QEMU has published a PID, ensure the hypervisor process is alive.
if [ -s "${QEMU_DIR}/qemu.pid" ]; then
  qpid="$(tr -d '[:space:]' < "${QEMU_DIR}/qemu.pid")"
  if [[ "$qpid" =~ ^[1-9][0-9]*$ ]] && ! kill -0 "$qpid" 2>/dev/null; then
    echo "QEMU process ${qpid} is not running" >&2
    exit 1
  fi
fi

exit 0

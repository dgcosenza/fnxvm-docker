# Efficiency gate (overall >= 95% strict).
# highestUserWastedPercent is tuned to 0.15 because daily `apt-get -y upgrade`
# and dpkg/debconf metadata updates on Debian stable necessarily overwrite files
# from the base layer against the runtime layer.
rules:
  lowestEfficiency: 0.95
  highestUserWastedPercent: 0.15
